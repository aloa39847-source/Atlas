# Repository-wide secret and local-runtime exclusions.
# Keep the immutable reference ZIP tracked; do not add a blanket *.zip rule.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
**/*creds*.json
**/*credentials*.json

# Local runtime data and logs.
*.db
*.sqlite
*.sqlite3
*.sqlite*
*.log
__pycache__/
.pytest_cache/
.venv/
venv/
node_modules/
.DS_Store
Thumbs.db
