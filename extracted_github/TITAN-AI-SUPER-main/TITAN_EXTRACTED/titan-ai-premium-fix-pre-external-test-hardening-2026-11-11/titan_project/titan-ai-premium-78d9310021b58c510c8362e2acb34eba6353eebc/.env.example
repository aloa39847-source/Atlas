# TITAN AI PREMIUM - example environment (NO secrets committed)
TITAN_APP_ENV=development
# Required before storing credentials: generate a unique random secret of at least 32 characters.
TITAN_SECRET_KEY=
TITAN_DATABASE_URL=sqlite:///./backend/data/titan.db

# Private access (set password locally via: cd backend && python -m app.scripts.set_initial_password --email ...)
TITAN_AUTH_REQUIRED=true
TITAN_ALLOWED_EMAILS=owner@example.com  # Replace with your own login email

# Binance Live execution is hard-disabled in this release.
# This variable is retained for compatibility but is ignored; setting it true cannot enable orders.
# A future release requires an explicit user decision and a separate safety review.
TITAN_LIVE_TRADING_ENABLED=false
# Additional Live execution gates; all must be explicitly reviewed and enabled.
TITAN_LIVE_GEO_ELIGIBLE_CONFIRMED=false
TITAN_LIVE_KYC_CONFIRMED=false
TITAN_LIVE_RATE_LIMIT_CONTROL_ENABLED=false

# Binance credentials are entered only through the authenticated TITAN dashboard
# and stored encrypted server-side. Do NOT put Binance API keys/secrets in this file.
# Protected GitHub Actions secrets are used only by isolated CI smoke checks.
BINANCE_ENV=demo
BINANCE_MARKET=spot

# Telegram (configure later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# AI providers (OpenAI primary; app-entered keys are encrypted server-side using TITAN_SECRET_KEY)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional local AI (no API key; install a compatible local runtime/model separately)
TITAN_LOCAL_AI_ENABLED=false
TITAN_LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
TITAN_LOCAL_AI_MODEL=qwen2.5:1.5b

# Binance Testnet (External Demo). Enter Spot/Futures keys in the authenticated TITAN dashboard only.
# Spot and USD-M Futures credentials are stored separately; never reuse a key across markets.
BINANCE_TESTNET_MARKET=spot

# Token unlock schedules (Tokenomist API plan/key required; personal/non-commercial use only)
TOKENOMIST_API_KEY=

# US economic calendar (optional key raises provider rate limit; attribution required)
XOOMAR_API_KEY=

# Knowledge source verification (comma-separated extra trusted HTTPS domains; defaults are built in)
TITAN_KNOWLEDGE_TRUSTED_DOMAINS=
